{
  "name": "termw",
  "version": "0.1.0",
  "description": "Fast web terminal — WASM + Korean IME, theme-synced PTY",
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "author": "termw contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/smturtle2/termw.git"
  },
  "homepage": "https://github.com/smturtle2/termw#readme",
  "bugs": {
    "url": "https://github.com/smturtle2/termw/issues"
  },
  "keywords": [
    "terminal",
    "web-terminal",
    "wasm",
    "zig",
    "pty",
    "korean",
    "ime",
    "xterm",
    "node-pty",
    "wterm"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build:wasm && npm run build:client && npm run build:server",
    "build:client": "esbuild src/client/main.ts --bundle --format=esm --target=es2022 --outfile=public/app.js --loader:.css=text --alias:@wterm/core=./vendor/wterm/packages/@wterm/core/src/index.ts --alias:@wterm/dom=./vendor/wterm/packages/@wterm/dom/src/index.ts --sourcemap --log-level=info",
    "build:server": "tsc -p tsconfig.server.json",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:wasm:force": "bash scripts/build-wasm.sh --force",
    "dev": "tsx src/server/index.ts",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "format": "prettier --write \"src/**/*.{ts,js,css}\""
  },
  "dependencies": {
    "ws": "^8.18.2",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "tsx": "^4.19.0",
    "@types/ws": "^8.18.0",
    "@types/node": "^22.0.0"
  }
}
