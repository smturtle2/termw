{
  "name": "termw",
  "version": "0.1.0",
  "description": "Fast web terminal — WASM + Korean IME, theme-synced PTY",
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "author": "termw contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/smturtle2/termw.git"
  },
  "homepage": "https://github.com/smturtle2/termw#readme",
  "bugs": {
    "url": "https://github.com/smturtle2/termw/issues"
  },
  "keywords": [
    "terminal",
    "web-terminal",
    "wasm",
    "zig",
    "pty",
    "korean",
    "ime",
    "xterm",
    "wterm",
    "bun"
  ],
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "trustedDependencies": ["esbuild"],
  "scripts": {
    "build": "bun run build:wasm && bun run build:client && bun run build:server",
    "build:client": "esbuild src/client/main.ts --bundle --format=esm --target=es2022 --outfile=public/app.js --sourcemap --log-level=info",
    "build:server": "tsc -p tsconfig.server.json",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:wasm:force": "bash scripts/build-wasm.sh --force",
    "dev": "bun --watch src/server/index.ts",
    "start": "bun dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write \"src/**/*.{ts,js,css}\"",
    "theme": "bun scripts/theme.ts",
    "theme:get": "bun scripts/theme.ts get",
    "theme:set": "bun scripts/theme.ts set",
    "theme:validate": "bun scripts/theme.ts validate"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.0.0"
  }
}
