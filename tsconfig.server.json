    "rootDir": "src",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/server/**/*", "src/shared/**/*"],
  "exclude": ["src/client", "node_modules", "dist", "vendor", "public"]
}
